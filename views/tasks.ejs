<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Task</title>
  </head>
  <body>
    <h1>Task</h1>
    <a href="/tasks/add">Add New Task</a>
    <a href="/dashboard">Dashboard</a>
    
    <table border="1">
      <tr>
        <th>Title</th>
        <th>description</th>
        <th>Status</th>
        <th>Edit</th>
        <th>Remove</th>
      </tr>
    <% tasks.forEach(task=>{ %>
     <tr>
      <td><%= task.title %></td>
      <td><%= task.description %></td>
      <td><%= task.status %></td>
      <td><a href="/tasks/edit/<%= task.id %>">Edit</a></td>
      <td>
        <form method="post" action="/tasks/delete/<%= task.id %>">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </table>
  </body>
</html>